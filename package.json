{
  "name": "agent-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Coding learner to AI application engineer: project, practice and staged assessment.",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=8"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "concurrently --kill-others-on-fail \"node --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/foundation.test.ts tests/classroom.test.mjs tests/study.test.mjs tests/tutorials.test.mjs",
    "test:tutorials": "node --test tests/tutorials.test.mjs",
    "practice:stage1": "node --test assessments/stage-01/practice.test.ts",
    "build": "npm run classroom:build && vite build",
    "check": "npm run typecheck && npm run teaching:format:check && npm test && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "lesson:01": "node examples/lesson-01/boundaries.ts",
    "classroom:build": "node scripts/build-classroom.mjs",
    "tutorial": "node scripts/run-tutorial.mjs",
    "teaching:format": "node scripts/format-teaching.mjs",
    "teaching:format:check": "node scripts/format-teaching.mjs --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
